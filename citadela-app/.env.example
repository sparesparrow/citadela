# ---------- Database ----------
# Postgres i ve vyvoji — ctecky zapisuji soubezne a SQLite by zamykala.
# Lokalne napr. `postgres://citadela:citadela@localhost:5432/citadela`.
# Na produkci (Neon) musi retezec koncit `?sslmode=require`.
DATABASE_URL="postgresql://citadela:citadela@localhost:5432/citadela"

# ---------- Auth.js ----------
# Vygenerujte: openssl rand -base64 32
AUTH_SECRET=""
# V produkci verejna adresa webu: https://citadela-resort.cz
# Slouzi zaroven jako metadataBase pro OG tagy, takze musi byt bez lomitka
# na konci a musi odpovidat tomu, co vidi navstevnik (tedy apex, ne www).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Google OAuth ----------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# a na produkci https://citadela-resort.cz/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Admin (seed) ----------
ADMIN_EMAIL="admin@citadela.cz"
ADMIN_PASSWORD="zmente-me-pred-nasazenim"

# ---------- Booking.com ----------
# Affiliate ID (AID) z partner.booking.com -> pripojuje se ke vsem deep-linkum
BOOKING_AID=""
# Ciselne ID objektu z extranetu (Booking je zna i pod textovym slugem,
# ale ten jde prejmenovat — ID ne). Odkazy se stavi na nej.
BOOKING_HOTEL_ID="17085726"
# Volitelne: textova cesta k objektu, napr. cz/citadela. Kdyz je vyplnena,
# odkazy miri primo na stranku objektu misto na vyhledavani podle ID.
BOOKING_HOTEL_PATH=""
# iCal export z Booking Extranet -> Rates & Availability -> Sync calendars
# Vice kalendaru oddelte carkou; poradi odpovida poradi pokoju v src/lib/site.ts
BOOKING_ICAL_URLS=""
# ---------- E-mail (Resend) ----------
# Bez klice se upozorneni na poptavku jen zaloguje, poptavka se ulozi vzdy.
RESEND_API_KEY=""
# Overena odesilaci adresa, napr. "Citadela Resort <rezervace@citadela-resort.cz>"
MAIL_FROM=""
# Kam chodi upozorneni na nove poptavky; vychozi je site.email
INQUIRY_NOTIFY_TO=""
# Kolik poptavek z jedne adresy za 10 minut. Vychozi 5; e2e sada potrebuje vic.
INQUIRY_RATE_LIMIT_MAX=""

# Sdilene tajemstvi pro /api/cron/sync a /api/cron/retention
# (posilejte jako ?secret= nebo Bearer)
CRON_SECRET=""

# ---------- Pristupovy system ----------
# Jak dlouho drzet zaznamy o pruchodech (AccessEvent). Jde o osobni udaj —
# pohyb konkretni osoby po budove — takze retence neni volitelna.
# Vychozi hodnota je 90 dnu; 0 a zaporna cisla se ignoruji.
ACCESS_EVENT_RETENTION_DAYS="90"
