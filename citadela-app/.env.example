# ---------- Database ----------
# Vývoj: SQLite. Produkce: přepněte provider v prisma/schema.prisma na "postgresql".
DATABASE_URL="file:./dev.db"

# ---------- Auth.js ----------
# Vygenerujte: openssl rand -base64 32
AUTH_SECRET=""
# V produkci nastavte na veřejnou URL, např. https://citadela.cz
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Google OAuth ----------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Admin (seed) ----------
ADMIN_EMAIL="admin@citadela.cz"
ADMIN_PASSWORD="zmente-me-pred-nasazenim"

# ---------- Booking.com ----------
# Affiliate ID (AID) z partner.booking.com -> pripojuje se ke vsem deep-linkum
BOOKING_AID=""
# Cesta k objektu na Booking.com, napr. cz/citadela
BOOKING_HOTEL_PATH="cz/citadela"
# iCal export z Booking Extranet -> Rates & Availability -> Sync calendars
# Vice kalendaru oddelte carkou; poradi odpovida poradi pokoju v src/lib/site.ts
BOOKING_ICAL_URLS=""
# Sdilene tajemstvi pro /api/cron/sync (posilejte jako ?secret= nebo Bearer)
CRON_SECRET=""
